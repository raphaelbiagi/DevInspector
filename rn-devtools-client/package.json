{
  "name": "rn-devtools-client",
  "version": "1.0.0",
  "description": "DevInspector client SDK for React Native — sends network and console logs to the desktop DevTools",
  "license": "MIT",
  "keywords": [
    "react-native",
    "expo",
    "devtools",
    "debugger",
    "network-inspector",
    "sqlite"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.0.0",
    "react-native": "^0.79.0",
    "typescript": "^5.7.0"
  }
}
